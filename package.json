{
  "name": "teachaxo",
  "version": "1.0.1",
  "description": "Desktop app for student records, grading, and schedule management.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "school",
    "journal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "semantic-ui-css": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.teachaxo.app",
    "productName": "TeachAxo",
    "buildVersion": "1.0.1.1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater-preload.js",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "axobeasty",
        "repo": "TeachAxo"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
